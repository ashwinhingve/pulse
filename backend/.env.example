# Local-only example. Use distinct secrets and never commit populated environment files.
NODE_ENV=development
PORT=3001
API_PREFIX=api
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=pulselogic
DB_PASSWORD=replace_with_local_database_password
DB_DATABASE=pulselogic_dev
DB_SYNCHRONIZE=true
DB_SSL=false
JWT_SECRET=replace_with_random_secret
JWT_REFRESH_SECRET=replace_with_different_random_secret
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
ENCRYPTION_KEY=replace_with_32_byte_secret_value
BCRYPT_ROUNDS=12
CORS_ORIGIN=http://localhost:4050
# Hosted deployments use migrations; disable synchronization and sample data.
# NODE_ENV=production
# DB_SYNCHRONIZE=false
# SEED_DEMO_DATA=false
# Set DB_SSL and DB_SSL_REJECT_UNAUTHORIZED to match the database provider.
# Use one working credential. Never use NEXT_PUBLIC_ for AI keys.
GEMINI_API_KEY=
GEMINI_MODEL_ID=
GROQ_API_KEY=
GROQ_MODEL_ID=llama-3.3-70b-versatile
# Optional OpenAI-compatible override: set all three together.
AI_API_KEY=
AI_BASE_URL=
AI_MODEL_ID=
AI_VISION_MODEL_ID=
# Optional existing Google service-account configuration.
GOOGLE_APPLICATION_CREDENTIALS_JSON=
VERTEX_MODEL_ID=gemini-2.5-flash
